<?xml version="1.0" encoding="utf-8"?>
<!-- 生活清单启动图标前景：无描边圆角白屋（屋脊屋檐圆化）+ 橘红烟囱点缀；
     屋里一个 2×2 极简线框面板（十字分格、无底）：
     待办一笔勾 / 基金一笔箭头 / 体重一笔波浪 / 资产一笔圆环——一个 App 装下生活所有事 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 橘红烟囱（下半被屋顶遮挡，只露屋面以上） -->
    <path
        android:fillColor="#FFFF5C33"
        android:pathData="M61,31 H69 V49 H61 Z" />
    <!-- 白色圆角屋身 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M42,49 H66 a6,6 0 0 1 6,6 V69 a6,6 0 0 1 -6,6 H42 a6,6 0 0 1 -6,-6 V55 a6,6 0 0 1 6,-6 Z" />
    <!-- 白色圆角屋顶（屋脊与屋檐端头圆化，底边压在屋身顶部） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M56.9,27.7 L79.1,48.3 Q82,51 78,51 L30,51 Q26,51 28.9,48.3 L51.1,27.7 Q54,25 56.9,27.7 Z" />

    <!-- 屋中面板：局部坐标经 group 映射（等价 html 的 translate(54,60) scale(.75)） -->
    <group
        android:name="panel"
        android:translateX="-4.6"
        android:translateY="10"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:pivotX="58.6"
        android:pivotY="50">
        <!-- 十字分隔（竖线收短不超屋底） -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFC9BBF7"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M58.5,36 V66 M42,50 H75" />
        <!-- 待办：蓝 · 单勾 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF4F63E8"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M45.5,42 L48.5,45 L52.5,39.5" />
        <!-- 基金：橙 · 斜上箭头 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFF7A59"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M64.5,45.5 L71,39 M67,39 H71 V42.8" />
        <!-- 体重：绿 · 单波浪 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF66D6B2"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M45,59.5 q2.6,-3.2 5.2,0 t5.2,0" />
        <!-- 资产：紫 · 单圆环 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF9575F2"
            android:strokeWidth="2.5"
            android:pathData="M68,56.3 a3.2,3.2 0 1,0 0,6.4 a3.2,3.2 0 1,0 0,-6.4" />
    </group>
</vector>
