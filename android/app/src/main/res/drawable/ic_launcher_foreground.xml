<?xml version="1.0" encoding="utf-8"?>
<!-- 生活清单启动图标前景：白色圆角纸飞机即钟面，时针指机头、分针指左尾，橙色原点（与网站 favicon 同设计） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 纸飞机：白填充 + 同色粗描边圆化尖角 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.9"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M79.2,28.8 L28.8,50.8 L53.3,57.2 L59.8,79.2 Z" />
    <!-- 分针（细长，指左尾尖）先画；时针（短粗，指机头） -->
    <path
        android:strokeColor="#FF4F63E8"
        android:strokeWidth="4.3"
        android:strokeLineCap="round"
        android:pathData="M58.6,50 L39.2,50.5" />
    <path
        android:strokeColor="#FF4F63E8"
        android:strokeWidth="5.4"
        android:strokeLineCap="round"
        android:pathData="M58.6,50 L65.2,43.1" />
    <!-- 交叉原点：品牌暖橙，与蓝紫针身区分 -->
    <path
        android:fillColor="#FFFF7A59"
        android:pathData="M58.6,50 m-3.4,0 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0" />
</vector>
