<?xml version="1.0" encoding="utf-8"?>
<!-- 生活清单启动图标前景：白屋 + 马卡龙撞色描边（深紫屋顶 / 粉两边 / 薄荷绿底边），
     橙黄烟囱飘两朵小白云；屋中蓝紫机芯，分针正上、时针右上约 65° 夹角，橙点中心 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 炊烟：远处小白云 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M50,16.2 a4.6,2.8 0 1,0 0,5.6 a4.6,2.8 0 1,0 0,-5.6 M47.6,14.3 a2.5,2.5 0 1,0 0,5 a2.5,2.5 0 1,0 0,-5 M52.8,13.2 a3,3 0 1,0 0,6 a3,3 0 1,0 0,-6" />
    <!-- 炊烟：近处大白云 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M58.5,24.7 a6.2,3.8 0 1,0 0,7.6 a6.2,3.8 0 1,0 0,-7.6 M55,22.3 a3.3,3.3 0 1,0 0,6.6 a3.3,3.3 0 1,0 0,-6.6 M62,20.8 a4,4 0 1,0 0,8 a4,4 0 1,0 0,-8" />

    <!-- 白色填充：烟囱（奶黄） / 屋顶 / 屋身 -->
    <path
        android:fillColor="#FFFFE3A6"
        android:pathData="M60,35 H68 V50 H60 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M28,53 L54,30 L80,53 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M37,53 H71 V77 H37 Z" />

    <!-- 烟囱描边：橙黄（竖边只到屋面斜线） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFB347"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M60,47.7 V35 H68 V40.6" />
    <!-- 屋顶描边：深紫 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF6D28D9"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M28,53 L54,30 L80,53" />
    <!-- 屋身两边：草莓粉 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFF85A1"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M37,53 V77" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFF85A1"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M71,53 V77" />
    <!-- 屋身底边：薄荷绿 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF66D6B2"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M37,77 H71" />

    <!-- 机芯：分针（正上，细） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF4F63E8"
        android:strokeWidth="3.8"
        android:strokeLineCap="round"
        android:pathData="M54,63 L54,45.9" />
    <!-- 机芯：时针（右上，粗）——与分针约 65° 夹角 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF4F63E8"
        android:strokeWidth="4.8"
        android:strokeLineCap="round"
        android:pathData="M54,63 L61.7,59.5" />
    <!-- 机芯中心：橙点 -->
    <path
        android:fillColor="#FFFF7A59"
        android:pathData="M54,63 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
</vector>
