<?xml version="1.0" encoding="utf-8"?>
<!-- 通知小图标（状态栏/通知栏/通知动作）：系统只取 alpha，白色剪影 + 透明底。
     开口环 + 环内纸飞机；晨光橙点在 24dp 状态栏下是游离噪点，故不画。
     通知图标不受 app 图标 66dp 安全区约束（不被 mask 裁），环用 r29 饱满放大、显眼。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 开口环 r29：端头位于 342°/292° -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M81.6,45.0 A29,29 0 1,1 64.9,27.1" />
    <!-- 纸飞机：缩到 0.55 倍，收进环内（机头距环内壁净 3.7） -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.55"
        android:scaleY="0.55">
        <path
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M79.2,28.8 L28.8,50.8 L53.3,57.2 L59.8,79.2 Z" />
    </group>
</vector>
